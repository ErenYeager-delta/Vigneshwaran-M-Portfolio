# ══════════════════════════════════════════════════════
# .env.example — Safe template to share on GitHub
# Copy this to .env and fill in your real values
# ══════════════════════════════════════════════════════

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Flask secret key (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-random-secret-key-here

# Admin panel password (plain text — will be hashed on first use)
ADMIN_PASSWORD=your-admin-password

# Admin panel hidden URL path
ADMIN_SECRET_PATH=/your-secret-path-2025

# Your live site domain (update after deploying to Render/custom domain)
SITE_URL=https://vigneshwaranm.onrender.com

# EmailJS (for contact form)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx

# Port (Render sets this automatically, leave as 5000 for local dev)
PORT=5000
